{
  "comment": "The Gallery — complexity showcase. Hero mesh (glass) center, supporting meshes flanking, material-sample spheres in a back arc, DoF on the hero, elevated emissive key light (kept off the floor to avoid the Bug #1 base-hotspot), checkerboard floor to horizon. Start at low res/AA to check scale, then crank.",

  "camera_pos": [0, 6, 18],
  "camera_target": [0, 2.5, 0],
  "aperture": 0.35,
  "focus_dist": 18,

  "width": 640,
  "height": 400,
  "exposure": 1.2,

  "env_file": "",
  "env_intensity": 1.0,

  "meshes": [
    {
      "comment": "HERO — glass. Swap to happy.obj once scale is dialed in for the full BVH stress test.",
      "file": "models/armadillo.obj",
      "pos": [0, 0, 0],
      "scale": 1.0,
      "color": [0.85, 0.9, 1.0],
      "material": "glass",
      "reflectivity": 0.1,
      "ior": 1.5
    },
    {
      "comment": "LEFT support — metallic, reflects the hero and the scene.",
      "file": "models/suzanne2.obj",
      "pos": [-7, 0, -2],
      "scale": 1.0,
      "color": [1.0, 0.85, 0.4],
      "material": "metallic",
      "reflectivity": 0.9,
      "ior": 0.5
    },
    {
      "comment": "RIGHT support — textured plastic (teapot has UVs, so a procedural texture will map).",
      "file": "models/teapot_uv.obj",
      "pos": [7, 0, -2],
      "scale": 1.0,
      "color": [0.2, 0.7, 0.9],
      "material": "plastic",
      "reflectivity": 0.1,
      "tex_type": 1,
      "tex_scale": 4.0,
      "tex_color2": [0.05, 0.15, 0.3]
    }
  ],

  "spheres": [
    {"comment": "back-arc material samples, left to right",
     "pos": [-9, 2, -8], "radius": 2.0, "reflectivity": 0.1, "color": [0.2, 1.0, 0.4], "material": "plastic"},
    {"pos": [-4.5, 2, -9], "radius": 2.0, "reflectivity": 0.1, "ior": 1.5, "color": [0.9, 0.95, 1.0], "material": "glass"},
    {"pos": [0, 2, -10], "radius": 2.0, "reflectivity": 0.1, "color": [0.6, 0.9, 1.0], "material": "subsurface"},
    {"pos": [4.5, 2, -9], "radius": 2.0, "reflectivity": 0.9, "ior": 0.5, "color": [0.95, 0.6, 0.9], "material": "metallic"},
    {"pos": [9, 2, -8], "radius": 2.0, "reflectivity": 0.1, "color": [1.0, 0.9, 0.7], "material": "plastic",
     "tex_type": 3, "tex_scale": 3.0, "tex_color2": [0.6, 0.3, 0.1]},

    {"comment": "small foreground glass marbles for depth / DoF foreground interest",
     "pos": [-3, 0.7, 8], "radius": 0.7, "reflectivity": 0.1, "ior": 1.5, "color": [1.0, 0.95, 0.9], "material": "glass"},
    {"pos": [3, 0.7, 9], "radius": 0.7, "reflectivity": 0.1, "ior": 1.5, "color": [0.9, 1.0, 0.95], "material": "glass"},

    {"comment": "EMISSIVE key light — elevated well off the floor (y=9) and behind-left, so the Bug #1 1/dist^2 base-hotspot has nothing near it to pool on. Warm.",
     "pos": [-8, 9, 4], "radius": 1.5, "reflectivity": 0.0, "color": [1.0, 0.5, 0.2], "material": "emissive"},
    {"comment": "second emissive — cool fill, high on the right, also clear of the floor",
     "pos": [9, 10, 3], "radius": 1.2, "reflectivity": 0.0, "color": [0.3, 0.5, 1.0], "material": "emissive"}
  ],

  "lights": [
    {"comment": "soft area key from above", "pos": [0, 14, 6], "size": 4}
  ],

  "floor": {"checkerboard": true},

  "output": "images/showcase.png"
}
